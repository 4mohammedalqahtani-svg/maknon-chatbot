# ===== انسخ هذا الملف إلى .env عند التجربة محليًا فقط =====
# لا ترفع ملف .env إلى GitHub أبدًا (هو مستثنى في .gitignore)

# مفتاح OpenAI — من https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-ضع-مفتاحك-هنا

# اسم النموذج (يمكن تغييره دون تعديل الكود)
OPENAI_MODEL=gpt-5-mini

# مفتاح Google المقيَّد على Google Drive API فقط
GOOGLE_API_KEY=AIza-ضع-مفتاحك-هنا

# معرّف مجلد Google Drive (الجزء الذي يلي /folders/ في رابط المجلد)
DRIVE_FOLDER_ID=1fYX8fYJv2Vn9S0FVUoRdr2ILl6AmYzgh

# ===== إعدادات اختيارية (لها قيم افتراضية مناسبة) =====
# أقصى عدد رسائل للزائر الواحد في الدقيقة
RATE_LIMIT_PER_MINUTE=6
# أقصى عدد رسائل للزائر الواحد في اليوم
RATE_LIMIT_PER_DAY=60
# أقصى طول للسؤال بالأحرف
MAX_QUESTION_CHARS=600
# أقصى طول للإجابة بالتوكنز
MAX_ANSWER_TOKENS=700
# مستوى "التفكير" لنماذج gpt-5 (minimal أرخص وأسرع، low أدق قليلًا)
OPENAI_REASONING_EFFORT=low
# كلمات إذا وردت في اسم ملف أو مجلد في الدرايف استُبعد تمامًا من معرفة المساعد.
# اتركه فارغًا لاستخدام القائمة الافتراضية (موظف، رواتب، هوية، بيانات شخصية... إلخ).
DRIVE_EXCLUDE_PATTERNS=

# نطاقات إضافية مسموح لها باستدعاء الخدمة (مفصولة بفاصلة)، مثال:
# ALLOWED_ORIGINS=https://maknon.org.sa,https://www.maknon.org.sa
ALLOWED_ORIGINS=

# ===== الواتساب (التفاصيل في WHATSAPP_SETUP_AR.md) =====
# رمز الوصول الدائم (System User token)
WHATSAPP_TOKEN=
# معرّف رقم الجوال في ميتا — تغييره وحده ينقل المساعد لرقم آخر
WHATSAPP_PHONE_NUMBER_ID=
# App secret من إعدادات تطبيق ميتا
WHATSAPP_APP_SECRET=
# كلمة سر تختارها وتكتبها نفسها في إعداد الـ Webhook
WHATSAPP_VERIFY_TOKEN=

# ===== مزوّد الذكاء الاصطناعي =====
# كل الاتصال به في netlify/functions/lib/ai.mjs (حاليًا openai فقط)
AI_PROVIDER=openai
